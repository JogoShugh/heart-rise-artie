{
  "testRunner": "command",
  "commandRunner": {
    "command": "cd ../conformance && npx cucumber-js"
  },
  "buildCommand": "npx tsc",
  "inPlace": true,
  "mutate": [
    "src/**/*.ts",
    "!src/index.ts"
  ],
  "reporters": [
    "clear-text",
    "progress"
  ],
  "clearTextReporter": {
    "allowColor": false,
    "reportTests": false,
    "reportScoreTable": true
  },
  "timeoutMS": 30000,
  "tempDirName": ".stryker-tmp",
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 87
  }
}
