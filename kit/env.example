# Copy to kit/.env and fill in, or let kit/setup.sh write it. The kit's scripts read it; git and Docker builds never
# see it.
#
# By default the kit needs nothing here: the release kit runs in containers on this machine, with a small GitHub,
# GitLab and Jenkins, no account and no key. Each of the two below is opt in:
#   ask   kit/setup.sh asks, and offers the key when this file holds one (the default)
#   yes   kit/setup.sh uses it, and only says so
#   no    kit/setup.sh leaves it off, and only says so
USE_GITHUB=ask
USE_ANTHROPIC=ask

# Your GitHub account: the repository the kit works on, an empty one of your own, and a fine-grained token for that
# repository alone (github.com/settings/personal-access-tokens/new): Repository access "Only select repositories",
# the one below; permissions Issues, Pull requests and Contents, read and write.
OWNER=your-github-user
REPO=kit-trial
GITHUB_TOKEN=

# An Anthropic key (console.anthropic.com), for the goals Claude walks on your repository. Replays of kept scripts
# don't need it, but triage's one reasoned step does.
ANTHROPIC_API_KEY=
