# Copy to kit/.env and fill in. kit/bootstrap.sh and kit/try.sh read it; git and Docker builds never see it.

# The repository the kit works on: an empty one of your own is enough.
OWNER=your-github-user
REPO=kit-trial

# A fine-grained token for that repository alone (github.com/settings/personal-access-tokens/new):
# Repository access "Only select repositories", the one above; permissions Issues, Pull requests and Contents,
# read and write.
GITHUB_TOKEN=

# For the goals Claude walks (console.anthropic.com). Replays of kept scripts don't need it, but triage's one
# reasoned step does.
ANTHROPIC_API_KEY=
