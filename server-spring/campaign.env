# What scripts/buster-campaign.sh needs to run a campaign on the garden server.
SERVER_DIR=server-spring
PORT=8080
COAP_PORT=5683
RESET=server-spring/reset-db.sh
SAMPLES=server-spring/explore-samples.json
# The client a campaign drives: "live" (the garden's own @live scenarios) or
# "explore" (ARTIE's explorer, the same for every domain). CAMPAIGN_CLIENT overrides.
CLIENT=live
