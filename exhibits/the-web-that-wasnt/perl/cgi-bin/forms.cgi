#!/usr/bin/perl
# forms.cgi -- writes forms.html from library.def, as a site in the web that wasn't publishes what it can do.
# There are no form controls in this world: forms.html lists every address, its method and what to type,
# and you type it into your browser yourself.
use strict;
use warnings;
use CGI qw(:standard -no_xhtml);

my $def = $ENV{LIBRARY_DEF} || '/usr/local/apache2/library.def';
open(my $in, '<', $def) or die "cannot read $def: $!";
my @operations;
my $current;
while (my $line = <$in>) {
    chomp $line;
    next if $line =~ /^#/;
    if ($line =~ /^\s*$/) { undef $current; next; }
    my ($key, $value) = $line =~ /^(\w+):\s*(.*)$/ or next;
    if (!$current) { $current = { fields => [], answers => [] }; push @operations, $current; }
    if ($key eq 'field' || $key eq 'answer') {
        push @{ $current->{"${key}s"} }, [ split /\s*\|\s*/, $value, 2 ];
    } else {
        $current->{$key} = $value;
    }
}
close $in;

my $updated = (stat $def)[9];
my @time = gmtime $updated;

print header(-type => 'text/html', -charset => 'ISO-8859-1');
print start_html(-title => 'Riverside Public Library -- forms.html', -bgcolor => '#FFFFFF');
print h1('Riverside Public Library'), h2('forms.html: everything you can do here');
print p('To do something, type its address into your browser. Put your own values where it says {like this}.'),
      p('If it says POST, choose POST in your browser and type the body into the body box, exactly as shown.');
print hr();

my $n = 0;
for my $op (@operations) {
    $n++;
    print h3("$n. " . uc $op->{title});
    my @rows = (Tr(td(b('Method')), td(tt($op->{method}))), Tr(td(b('Address')), td(tt(escapeHTML($op->{address})))));
    push @rows, Tr(td(b('Body')), td(tt(escapeHTML($op->{body})))) if $op->{body};
    print table({ -border => 0, -cellpadding => 2 }, @rows);
    print p(b('What to type:')), ul(map { li(tt("{$_->[0]}") . " -- $_->[1]") } @{ $op->{fields} });
    print p(b('Answers:')), ul(map { li(tt($_->[0]) . " -- $_->[1]") } @{ $op->{answers} });
    print hr();
}

print p(i('Best viewed in a browser with a method menu and a body box.')),
      p(small(sprintf('Last updated %04d-%02d-%02d. Generated by forms.cgi from library.def.',
          $time[5] + 1900, $time[4] + 1, $time[3])));
print end_html();
