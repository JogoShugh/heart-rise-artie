#!/usr/bin/perl
# forms.cgi -- writes forms.html from library.openapi.yaml, as a site in the web that wasn't publishes what it can
# do. There are no form controls in this world: forms.html lists every operation, its method, its address and what
# to type, and you type it into your browser yourself.
use strict;
use warnings;
use CGI qw(:standard -no_xhtml);
use YAML::XS qw(LoadFile);

my $file = $ENV{LIBRARY_OPENAPI} || '/usr/local/apache2/library.openapi.yaml';
my $api = LoadFile($file);
my $server = $api->{servers}[0]{url} // '';

sub resolve {
    my ($node) = @_;
    return $node unless ref $node eq 'HASH' && $node->{'$ref'};
    my @path = grep { $_ ne '#' } split m{/}, $node->{'$ref'};
    my $at = $api;
    $at = $at->{$_} for @path;
    return $at;
}

my @time = gmtime((stat $file)[9]);
print header(-type => 'text/html', -charset => 'ISO-8859-1');
print start_html(-title => "$api->{info}{title} -- forms.html", -bgcolor => '#FFFFFF');
print h1($api->{info}{title}), h2('forms.html: everything you can do here');
print p('To do something, type its address into your browser. Put your own values where it says {like this}.'),
      p('If it says POST, choose POST in your browser and type the body into the body box, exactly as shown.');
print hr();

my $n = 0;
for my $path (sort keys %{ $api->{paths} }) {
    for my $method (sort keys %{ $api->{paths}{$path} }) {
        my $op = $api->{paths}{$path}{$method};
        my @params = map { resolve($_) } @{ $op->{parameters} || [] };
        my @query = grep { $_->{in} eq 'query' } @params;
        my $address = $server . $path . (@query ? '?' . join('&', map { "$_->{name}={$_->{name}}" } @query) : '');
        my ($type) = keys %{ $op->{requestBody}{content} || {} };
        my $schema = $type ? resolve($op->{requestBody}{content}{$type}{schema}) : undef;
        my @body = $schema ? @{ $schema->{required} || [ sort keys %{ $schema->{properties} } ] } : ();
        my @fields = ((map { [$_->{name}, $_->{description}] } @params),
                      (map { [$_, $schema->{properties}{$_}{description}] } @body));

        print h3(++$n . '. ' . uc $op->{summary});
        print p(i($op->{description})) if $op->{description};
        my @rows = (Tr(td(b('Method')), td(tt(uc $method))), Tr(td(b('Address')), td(tt(escapeHTML($address)))));
        push @rows, Tr(td(b('Body')), td(tt(escapeHTML(join '&', map { "$_={$_}" } @body)))) if @body;
        print table({ -border => 0, -cellpadding => 2 }, @rows);
        print p(b('What to type:')), ul(map { li(tt("{$_->[0]}") . " -- $_->[1]") } @fields);
        print p(b('Answers:')),
              ul(map { li(tt($_) . " -- $op->{responses}{$_}{description}") } sort keys %{ $op->{responses} });
        print hr();
    }
}

print p(i('Best viewed in a browser with a method menu and a body box.')),
      p(small(sprintf('Last updated %04d-%02d-%02d. Generated by forms.cgi from library.openapi.yaml, OpenAPI %s.',
          $time[5] + 1900, $time[4] + 1, $time[3], $api->{openapi})));
print end_html();
